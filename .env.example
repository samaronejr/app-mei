# Django
SECRET_KEY=replace-with-a-unique-50-character-secret-key-value
DJANGO_SETTINGS_MODULE=config.settings.dev
DEBUG=True
LOG_LEVEL=INFO

# Host and origin policy.
# ALLOWED_HOSTS may use a leading dot to match tenant subdomains.
# CSRF_TRUSTED_ORIGINS must list every origin explicitly — a wildcard is rejected by
# the core.E003 system check, because cookies here are deliberately host-only.
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,web
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL. Parsed by django-environ into DATABASES["default"].
POSTGRES_DB=app_mei
POSTGRES_USER=app_mei
POSTGRES_PASSWORD=app_mei_password
DATABASE_URL=postgres://app_mei:app_mei_password@localhost:5432/app_mei
CONN_MAX_AGE=60

# Unprivileged test role. The dedicated app_test role is created by the role split in
# T-009; until then leave these empty to reuse the DATABASE_URL credentials.
TEST_DB_USER=
TEST_DB_PASSWORD=

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Sentry (production only; leave empty to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0

# TLS / HSTS (production only)
SECURE_HSTS_SECONDS=31536000
