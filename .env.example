# Django
SECRET_KEY=replace-with-a-unique-50-character-secret-key-value
DJANGO_SETTINGS_MODULE=config.settings.dev
DEBUG=True
LOG_LEVEL=INFO

# Host and origin policy.
# ALLOWED_HOSTS may use a leading dot to match tenant subdomains.
# CSRF_TRUSTED_ORIGINS must list every origin explicitly — a wildcard is rejected by
# the core.E003 system check, because cookies here are deliberately host-only.
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,web
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL. POSTGRES_* bootstrap the cluster superuser the image creates; the three
# application roles below are created by ops/sql/roles.sql on first initialization.
POSTGRES_DB=app_mei
POSTGRES_USER=app_mei
POSTGRES_PASSWORD=app_mei_password

APP_RUNTIME_PASSWORD=app_runtime_password
APP_MIGRATOR_PASSWORD=app_migrator_password
APP_TEST_PASSWORD=app_test_password

# The application connects as app_runtime: NOSUPERUSER, NOBYPASSRLS, owns no table.
# Pointing this at the superuser leaves every RLS policy inert and raises no error.
DATABASE_URL=postgres://app_runtime:app_runtime_password@localhost:5432/app_mei
# Used only by `manage.py migrate`. app_migrator owns the schema and has BYPASSRLS so
# RunPython backfills see every row instead of silently touching none.
DATABASE_MIGRATION_URL=postgres://app_migrator:app_migrator_password@localhost:5432/app_mei
CONN_MAX_AGE=60

# pytest-django must CREATE DATABASE and TRUNCATE, which app_runtime cannot do. Tests
# therefore connect as app_test and SET ROLE app_runtime per test, so the assertions
# still run under the unprivileged role that RLS actually bites.
TEST_DB_USER=app_test
TEST_DB_PASSWORD=app_test_password

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=540

# Sentry (production only; leave empty to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0

# TLS / HSTS (production only)
SECURE_HSTS_SECONDS=31536000

# Origin for platform-level links (invitations, LGPD data-subject intake).
PLATFORM_URL=http://localhost:8000
DEFAULT_FROM_EMAIL=nao-responda@localhost

# How many reverse proxies this deployment controls. 0 means X-Forwarded-For is not
# trusted at all. See ops/README.md — too high makes the client IP spoofable, too low
# collapses every user into one rate-limit bucket.
TRUSTED_PROXY_COUNT=0

# Rate limits. Login is keyed on email and IP, never on tenant.
RATELIMIT_LOGIN_EMAIL=5/m
RATELIMIT_LOGIN_IP=20/m
RATELIMIT_WRITE=60/m
RATELIMIT_READ=120/m

# The named encarregado (DPO) required by LGPD art. 41. See docs/lgpd.md.
LGPD_ENCARREGADO_EMAIL=encarregado@localhost
