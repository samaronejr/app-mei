# Production environment. Copy to .env.prod ON THE SERVER and fill in.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --wait
#
# Every secret below is referenced as ${VAR:?} in docker-compose.prod.yml, so a missing
# one fails the container at startup rather than inheriting a development default.
# .env.prod itself is git-ignored; this template is the committed shape.

# ---------------------------------------------------------------------------
# Hosts and TLS
# ---------------------------------------------------------------------------
# Both the wildcard and the apex, comma-separated. The wildcard covers every firm host
# `<slug>.<domain>` AND every portal host `<slug>-portal.<domain>`, because
# `acme-portal` is a single DNS label. That is why the portal host is
# `<slug>-portal.<domain>` and not `portal.<slug>.<domain>` — the latter is two labels
# and no public CA issues `*.*.<domain>`.
SITE_ADDRESS=*.example.dev, example.dev

# TLS is TWO variables and exactly one of them is set at a time. The split is forced by
# the Caddyfile grammar, which rejects a `{` with content after it on the same line — so
# `TLS_DIRECTIVE=tls { dns cloudflare ... }` cannot parse and the container will not
# start. The one-line global `acme_dns` option is the form that works.
#
# Staging, no domain — Caddy's own CA, browsers warn, no ACME, no port-80 dependency:
#   TLS_DIRECTIVE=tls internal
#   ACME_DNS_OPTION=
#
# Production, with a domain — default ACME issuing a wildcard over DNS-01:
TLS_DIRECTIVE=
ACME_DNS_OPTION=acme_dns cloudflare {env.CF_API_TOKEN}

# Required by ACME_DNS_OPTION. Scope it to Zone -> DNS -> Edit on this zone ONLY:
# DNS-01 writes a _acme-challenge TXT record and needs nothing more. A zone-wide or
# account-wide token here is a standing compromise of the whole domain.
CF_API_TOKEN=

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=

# A leading dot matches every subdomain, which is what both the firm hosts and the
# portal hosts need. Must correspond to SITE_ADDRESS or Django answers 400
# DisallowedHost behind a certificate that is perfectly valid.
ALLOWED_HOSTS=.example.dev

# Deliberately EMPTY, and a wildcard here is rejected outright by the core.E003 system
# check — `https://*.example.dev` fails `manage.py check` and the web container never
# starts. Cookies in this product are host-only, and a wildcard would re-admit exactly
# the sibling-subdomain origins that host-only cookies exist to exclude: one firm's
# page could then post to another firm's host with a valid token.
#
# Empty is correct rather than merely safe. Every form here posts to the host that
# served it, and Django accepts a same-origin POST by comparing Origin to the request
# host without consulting this list at all. Add an entry only for a genuine
# cross-origin POST, and then name that one origin in full.
CSRF_TRUSTED_ORIGINS=

# ---------------------------------------------------------------------------
# Proxy hops
# ---------------------------------------------------------------------------
# The number of proxies THIS deployment controls, counted from the right of
# X-Forwarded-For. Caddy alone is 1. Put Cloudflare in proxy mode ("orange cloud")
# in front of it and it becomes 2.
#
# Wrong in either direction fails silently, never loudly: too low collapses every user
# into the proxy's single rate-limit bucket, too high lets a caller spoof their own
# address and defeat every per-IP control. See ops/README.md.
TRUSTED_PROXY_COUNT=1

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=
PLATFORM_URL=https://example.dev

# Sender address shown on application-generated messages.
DEFAULT_FROM_EMAIL=nao-responda@example.dev
# Public contact for the named LGPD encarregado required by art. 41.
LGPD_ENCARREGADO_EMAIL=privacidade@example.dev

# Leave empty to disable Sentry reporting for this deployment.
SENTRY_DSN=
# Stable deployment label attached to Sentry events and transactions.
SENTRY_ENVIRONMENT=production
# Fraction from 0.0 to 1.0 of transactions sent to Sentry performance monitoring.
SENTRY_TRACES_SAMPLE_RATE=0.0

# ---------------------------------------------------------------------------
# Database and cache
# ---------------------------------------------------------------------------
POSTGRES_DB=app_mei
POSTGRES_USER=app_mei
POSTGRES_PASSWORD=
APP_MIGRATOR_PASSWORD=
APP_RUNTIME_PASSWORD=
APP_TEST_PASSWORD=
REDIS_URL=redis://redis:6379/0

# --- Object storage for portal documents (V4) -------------------------------------
# Production keeps document bytes in a PRIVATE OCI Object Storage bucket, reached over
# its S3-compatible API. Development and tests stay on FileSystemStorage, so the shipped
# backend is not the tested one: the swap needs its own verify-by-effect step against
# the real bucket, and every isolation assertion is written against the Django view's
# refusal, which is backend-independent.
#
# The bucket must be private. An unauthenticated GET returns 404 either way -- OCI
# conflates "absent" with "unauthorised" so it cannot leak existence -- so that refusal
# alone proves nothing. It only means "private" alongside an AUTHENTICATED read that
# succeeds against the same key.
#
# The key pair is an OCI Customer Secret Key, not an API signing key. Scope its IAM user
# to this one bucket: it lives in plaintext on an internet-facing host.
OCI_S3_BUCKET=
OCI_S3_REGION=
OCI_S3_ENDPOINT_URL=
OCI_S3_ACCESS_KEY_ID=
OCI_S3_SECRET_ACCESS_KEY=
